venv/
backend/venv/
env/
ENV/
.venv/

# Caches Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Dépendances et Builds Node.js (Frontend)
# ==========================================
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Logs Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# Variables d'Environnement & Clés Sécurisées
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Caches Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/
*.ipynb_checkpoints

